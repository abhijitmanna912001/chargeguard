# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# PostgreSQL connection string for Prisma (lib/db/prisma.ts, prisma7.config.ts).
# Placeholder format only; replace USER, PASSWORD and the host with your own.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/chargeguard?schema=public"

# Which agent the app runs (app/agent-mode.ts is the only reader):
#   mock (default) = built-in placeholder agent, no network, no key needed
#   live           = the real agent, which calls Sarvam
# Any other value falls back to mock with a console warning.
AGENT_MODE=mock

# Sarvam AI API key (server-side only; never prefix with NEXT_PUBLIC_).
# Only needed when AGENT_MODE=live. Read by agent-core/model, never committed.
SARVAM_API_KEY=

# Base URL of the payment provider API (lib/integrations/paytm-client.ts, the only reader).
# Defaults to http://localhost:3000, where this app serves the SIMULATED provider route.
# Change it if `next dev` runs on another port.
PAYTM_API_BASE_URL=http://localhost:3000

# Behaviour of the simulated provider route: ok (default) | fail (HTTP 503) | reject (HTTP 422).
MOCK_PAYTM_MODE=ok
